# /etc/crontab: system-wide crontab
#
# Versioned as etc/crontab in the oddb.org repository. Install with
#   sudo bin/install_crontab --apply
# which also installs bin/oddb_cron to /usr/local/sbin/oddb_cron as root.
#
# The nine ch.oddb.org jobs are no longer listed here - their times live in
# bin/oddb_cron, and the "schedule" line below runs whatever is due. See what
# that means in practice with:
#   oddb_cron schedule-list

SHELL=/bin/sh
PATH=/home/zdavatz/.rbenv/versions/3.4.5/bin/:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# m h dom mon dow user     command

# --- Debian defaults ---------------------------------------------------------
17 *	* * *	root	cd / && run-parts --report /etc/cron.hourly
25 6	* * *	root	test -x /usr/sbin/anacron || ( cd / && run-parts --report /etc/cron.daily )
47 6	* * 7	root	test -x /usr/sbin/anacron || ( cd / && run-parts --report /etc/cron.weekly )
52 6	1 * *	root	test -x /usr/sbin/anacron || ( cd / && run-parts --report /etc/cron.monthly )

# --- root ---------------------------------------------------------------------
# Separate lines because cron takes one user per line and these two are root.
0 1	* * *	root	/usr/local/sbin/oddb_cron certbot-renew > /dev/null
0 22	* * *	root	/usr/bin/nice /usr/local/sbin/oddb_cron backup > /dev/null

# --- ch.oddb.org --------------------------------------------------------------
* *	* * *	zdavatz	/usr/local/sbin/oddb_cron schedule

# --- other repositories -------------------------------------------------------
51 4	* * *	zdavatz	/home/zdavatz/sofware/swissmedicinfo/target/debug/swissmedicinfo --download --local >/dev/null 2>&1
0 7	* * *	zdavatz	/home/zdavatz/sofware/sdif/update_interactions
