#!/bin/sh
# Wrapper for the ch.oddb.org cron entries in /etc/crontab.
#
# Replaces the "bundle exec ruby jobs/X >/dev/null 2>&1"
# boilerplate that was repeated per line. The redirect to /dev/null is the part
# worth losing: it threw away every error message these jobs ever produced, so
# a failing import looked exactly like a successful one. Output now lands in
# log/cron/<job>-<YYYY-MM>.log - one file per job per month, so it stays
# greppable without growing without bound.
#
# Usage: bin/cron_job <job-name> [args...]
#   e.g. bin/cron_job import_bsv
#
# Note the jobs guard themselves against overlapping: everything matching
# ^update|^import|^rebuild|^repair shares log/job.pid, so whichever fires first
# holds it and a second one exits with a "Duplicate Job" notice instead of
# running concurrently.

root=$(cd "$(dirname "$0")/.." && pwd)
job=$1
[ -n "$job" ] || { echo "usage: $0 <job-name> [args...]" >&2; exit 2; }
shift

[ -f "$root/jobs/$job" ] || { echo "no such job: jobs/$job" >&2; exit 2; }

log_dir=$root/log/cron
mkdir -p "$log_dir" || exit 1
log=$log_dir/$job-$(date +%Y-%m).log

cd "$root" || exit 1

echo "=== $job started $(date '+%Y-%m-%d %H:%M:%S %z') ===" >> "$log"
# No set -e: the exit status has to survive so it can be logged and passed on
# to cron, which mails a failing job to the crontab owner.
bundle exec ruby "jobs/$job" "$@" >> "$log" 2>&1
status=$?
echo "=== $job finished $(date '+%Y-%m-%d %H:%M:%S %z') (exit $status) ===" >> "$log"
exit $status
