#!/bin/sh
# Installs the versioned crontab and the scripts it calls. Run with sudo.
#
#   sudo bin/install_crontab           # show what would change
#   sudo bin/install_crontab --apply   # do it
#
# Two files: the crontab, and bin/oddb_cron - which holds every script the
# crontab calls, as subcommands.
#
# Both end up owned by root, on purpose. cron runs the certbot and backup lines
# as root, so what it executes must not be writable by anyone else. The
# scripts this replaces were owned by zdavatz, the user the web application
# runs as, which was a path from a compromised application to root at 22:00.
#
# Left in place but no longer called by anything once this has been applied:
#   /usr/local/src/certbot_renew
#   /usr/local/sbin/ywesee-backup
# Edit bin/oddb_cron, not those - they are dormant copies now. Leaving the
# second one is safe precisely because nothing invokes it any more: it is owned
# by zdavatz, and it was cron running it as root at 22:00 that made that a
# problem.
#
# scripts/pg_backup.sh is installed too, but only once its credentials exist.
# The versioned copy carries no password on purpose; it reads db_password from
# etc/oddb.yml instead. Installing it without that key would turn the nightly
# backup into a silent failure, so a missing key skips that one file and makes
# this run exit non-zero.
#
# Not installed from here, deliberately:
#   sdif/update_interactions       lives in github.com/zdavatz/sdif
#   swissmedicinfo                 lives in github.com/zdavatz/swissmedicinfo

root=$(cd "$(dirname "$0")/.." && pwd)
apply=no
[ "$1" = "--apply" ] && apply=yes

[ "$(id -u)" = "0" ] || { echo "must run as root (use sudo)" >&2; exit 1; }

backup_dir=/var/backups/oddb-config
stamp=$(date +%Y%m%d-%H%M%S)

status=0

# src : dest : mode
set -- \
  "$root/etc/crontab:/etc/crontab:644" \
  "$root/bin/oddb_cron:/usr/local/sbin/oddb_cron:755"

# pg_backup.sh only with its credentials in place. Read in a subshell and never
# echoed, so the value reaches neither this script's environment nor the
# terminal.
oddb_yml=${ODDB_YML:-$root/etc/oddb.yml}
yml_mode=$([ -f "$oddb_yml" ] && stat -c '%a' "$oddb_yml")
db_password=$(sed -n "s/^db_password:[[:space:]]*//p" "$oddb_yml" 2>/dev/null | head -1 \
  | sed -e "s/^'\(.*\)'$/\1/" -e 's/^"\(.*\)"$/\1/')
if [ ! -r "$oddb_yml" ]; then
  echo "SKIP     /usr/local/sbin/pg_backup.sh - $oddb_yml is missing"
  status=1
elif [ -z "$db_password" ]; then
  echo "SKIP     /usr/local/sbin/pg_backup.sh - $oddb_yml sets no db_password"
  echo "         The versioned copy holds no password. Add the line first:"
  echo "           db_password: '<password>'"
  echo "         The value is still in line 148 of the installed pg_backup.sh."
  status=1
elif [ "$yml_mode" != "600" ] && [ "$yml_mode" != "400" ]; then
  echo "SKIP     /usr/local/sbin/pg_backup.sh - $oddb_yml is mode $yml_mode, want 600"
  echo "           chmod 600 $oddb_yml"
  status=1
else
  set -- "$@" "$root/scripts/pg_backup.sh:/usr/local/sbin/pg_backup.sh:755"
fi
db_password=

for entry in "$@"; do
  src=${entry%%:*}
  rest=${entry#*:}
  dest=${rest%%:*}
  mode=${rest#*:}

  if [ ! -f "$src" ]; then
    echo "MISSING  $src" >&2
    status=1
    continue
  fi

  if [ -f "$dest" ] && diff -q "$src" "$dest" >/dev/null 2>&1; then
    owner=$(stat -c '%U:%G %a' "$dest")
    if [ "$owner" = "root:root $mode" ]; then
      echo "ok       $dest"
      continue
    fi
    echo "CHOWN    $dest (is $owner, want root:root $mode)"
  elif [ -f "$dest" ]; then
    echo "UPDATE   $dest"
    # Der Diff wird angezeigt, und die abgeloeste pg_backup.sh traegt das
    # Passwort im Klartext - ohne diesen Filter druckt ein blosser Probelauf
    # "-PGPASSWORD='...'" auf das Terminal und in jedes Protokoll, das ihn
    # mitschreibt. Aufgefallen beim Testen, nicht beim Lesen.
    diff -u "$dest" "$src" \
      | sed -E "s/((PGPASSWORD|PASSWORD|SECRET|TOKEN|API_KEY)[[:space:]]*=[[:space:]]*).*/\\1<redacted>/I" \
      | sed 's/^/         /' | head -20
  else
    echo "CREATE   $dest"
  fi

  [ "$apply" = "yes" ] || continue

  if [ -f "$dest" ]; then
    mkdir -p "$backup_dir"
    cp -a "$dest" "$backup_dir/$(basename "$dest").$stamp"
    # 600, nicht die 755 des Originals: die abgeloeste pg_backup.sh traegt das
    # Passwort im Klartext, und eine Sicherung davon soll es nicht weiter
    # verteilen.
    chmod 600 "$backup_dir/$(basename "$dest").$stamp"
  fi
  install -o root -g root -m "$mode" "$src" "$dest" || status=1
done

if [ "$apply" = "yes" ]; then
  echo
  echo "backups in $backup_dir"
else
  echo
  echo "nothing changed - re-run with --apply"
fi
exit $status
