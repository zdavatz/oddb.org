#!/bin/sh
# Every script /etc/crontab calls, in one place.
#
#   oddb_cron schedule               run whatever is due this minute (as zdavatz)
#   oddb_cron schedule-list          show the schedule
#   oddb_cron job <name> [args...]   run one job by hand
#   oddb_cron certbot-renew          renew Let's Encrypt certificates (as root)
#   oddb_cron backup                 back up the database (as root)
#   oddb_cron healthcheck            restart a rack backend that stopped
#                                    answering (--dry-run to look only; also
#                                    runs as part of schedule, every minute)
#
# Installed to /usr/local/sbin/oddb_cron by bin/install_crontab, which makes it
# root-owned. That matters: cron runs certbot-renew and backup as root, and a
# script root executes must not be writable by anyone else. This repository is
# owned by zdavatz - the same user the web application runs as - so pointing a
# root cron line straight at /var/www/oddb.org/bin would turn a compromised
# application into root access. The repo holds the source; root runs the copy.
#
# Replaces, but does not remove, /usr/local/src/certbot_renew and
# /usr/local/sbin/ywesee-backup. Those stay on disk, dormant - nothing calls
# them once the new crontab is installed. Change behaviour here, not there.
#
# Not absorbed into this script:
#   /usr/local/sbin/pg_backup.sh  carries the postgres password in clear text,
#                                 so it stays out of version control
#   sdif/update_interactions      github.com/zdavatz/sdif
#   swissmedicinfo                github.com/zdavatz/swissmedicinfo

# Why the crontab points at /usr/local/sbin and not straight at this file in
# the repository: cron runs certbot-renew and backup as root, and this tree
# belongs to zdavatz - the user the web application runs as. A root cron line
# under /var/www would turn a compromised application into root access.
# bin/install_crontab copies this here as root:root 755.
#
# Which certificates renew how (see /etc/letsencrypt/renewal):
#   ch.oddb.org   standalone   ch.oddb.org, m.oddb.org, generika.cc,
#                              oekk.oddb.org, oddb.org, www.oddb.org
#   sdif.oddb.org apache
# (desitin.oddb.org was deleted in August 2026 with the flavor - it renewed a
# certificate Apache never served.)
#
# import_bsv (08:00) and import_swissmedic (08:15) overlap deliberately.
# Everything matching ^update|^import|^rebuild|^repair shares log/job.pid, so
# whichever fires first holds it and the second exits with a "Duplicate Job"
# notice. BSV publishes on the 1st of the month, Swissmedic somewhere in the
# first week; whichever wins the race gets that day and the other catches up
# the next morning.

ODDB_ROOT=${ODDB_ROOT:-/var/www/oddb.org}

usage() {
  sed -n '3,11p' "$0" | sed 's/^# \{0,2\}//'
  exit 2
}

require_root() {
  [ "$(id -u)" = "0" ] || { echo "$1 must run as root" >&2; exit 1; }
}

# Runs one of the jobs/ scripts, keeping its output.
#
# The crontab used to carry "bundle exec ruby jobs/X
# >/dev/null 2>&1" per line. Losing that redirect is the point: it threw away
# every error these jobs produced, so a failing import looked exactly like a
# successful one. Output goes to log/cron/<job>-<YYYY-MM>.log, one file per job
# per month, and the exit status is preserved so cron still mails a failure.
#
# The jobs guard themselves against overlapping: everything matching
# ^update|^import|^rebuild|^repair shares log/job.pid, so whichever fires first
# holds it and a second exits with a "Duplicate Job" notice.
cmd_job() {
  job=$1
  [ -n "$job" ] || usage
  shift
  [ -f "$ODDB_ROOT/jobs/$job" ] || { echo "no such job: jobs/$job" >&2; exit 2; }

  log_dir=$ODDB_ROOT/log/cron
  mkdir -p "$log_dir" || exit 1
  log=$log_dir/$job-$(date +%Y-%m).log

  cd "$ODDB_ROOT" || exit 1
  echo "=== $job started $(date '+%Y-%m-%d %H:%M:%S %z') ===" >> "$log"
  # No set -e: the exit status has to survive to be logged and passed to cron.
  bundle exec ruby "jobs/$job" "$@" >> "$log" 2>&1
  status=$?
  echo "=== $job finished $(date '+%Y-%m-%d %H:%M:%S %z') (exit $status) ===" >> "$log"
  return $status
}

# Apache is stopped for the duration because the oddb certificates renew with
# the standalone authenticator, which binds port 80 itself and cannot while
# Apache holds it - hence a short outage every night, and hence 01:00.
#
# The chown afterwards is not incidental: Apache runs as root and recreates log
# files under its own ownership on start, which would then stop the jobs
# running as zdavatz from writing them.
#
# To add a hostname, reissue with --expand. Hosts whose DNS does not resolve
# cannot be validated and fail the whole run - that is why just-medical.oddb.org
# is no longer in the list.
cmd_certbot_renew() {
  require_root certbot-renew
  /etc/init.d/apache2 stop
  certbot renew
  /etc/init.d/apache2 start
  chown -R zdavatz:zdavatz "$ODDB_ROOT/log/"
}

# What this does NOT do, despite the crontab having called it "backup to
# backup-disk": every rsync in the original was commented out, so nothing but
# the database is saved, and the dump lands in /var/backups on the same single
# disk as everything else. A disk failure takes the database, the dumps, the
# Apache config and the application with it.
cmd_backup() {
  require_root backup
  /usr/local/sbin/pg_backup.sh bv
  # keep five days of dumps
  for file in $(find /var/backups/db/postgresql -daystart -ctime +5); do
    rm -rf "$file"
  done
}

# The four rack processes Apache proxies to, and the port each listens on.
# Everything else under /etc/service is a DRb daemon with no HTTP port to ask.
# Fields: service name under /etc/service, port.
#
# generika is a process of its own, which is why it can - and did - fail on its
# own while ch.oddb.org kept serving.
HEALTH="
oddb            8012
google_crawler  8112
crawler         8212
generika        8512
"

# Consecutive failed minutes before this touches anything.
#
# These processes restart themselves constantly and that is by design: past
# MEMORY_LIMIT_CRAWLER (4000 MB, src/util/oddbapp.rb) the app raises SystemExit
# and daemontools brings it straight back. It needs roughly forty seconds to
# answer again, so one or two failures in a row are the normal cycle and must
# not trigger anything.
#
# What this is for is the other case. In August 2026 crawler was dead for 18.6
# days, generika for 10.3 and google_crawler for 9.7 - Apache answered every
# Googlebot request with a 503 the whole time, which is what Search Console
# then reported as "Serverfehler (5xx)". Nothing noticed, because svstat keeps
# reporting "up" as long as supervise itself runs, whether or not the child is
# there or listening. Five minutes is far past a restart and far short of that.
HEALTH_GRACE=5

# Alive means "something answered on the port", not "answered 200": a 500 from
# the application still proves the process is up, and this check has no
# business judging content. curl reports 000 when the connection is refused,
# which is exactly the state a missing backend leaves the port in. HEAD, so a
# probe every minute costs a header and not a rendered page.
health_probe() {
  code=$(curl -s -I -o /dev/null -m 5 -w '%{http_code}' "http://localhost:$1/" 2>/dev/null)
  case "$code" in
    "" | 000) return 1 ;;
    *) return 0 ;;
  esac
}

# Restarts a backend that has stopped answering.
#
# Runs as zdavatz, out of the same once-a-minute schedule line, so /etc/crontab
# still needs no entry of its own and nothing here runs as root. That works
# because svc only needs write access to /etc/service/<name>/supervise, which
# has nothing to do with the user the service itself runs as: crawler and
# google_crawler run as root behind a zdavatz-owned supervise directory, and
# generika runs as zdavatz. Should a supervise directory ever be root-owned
# again, svc fails and the failure is logged rather than swallowed.
#
# Silent while everything answers, so cron mails only when it acts.
cmd_healthcheck() {
  dry=""
  [ "$1" = "--dry-run" ] && dry=1

  state=$ODDB_ROOT/log/cron/health
  log=$ODDB_ROOT/log/cron/healthcheck-$(date +%Y-%m).log
  mkdir -p "$state" || exit 1

  while read -r name port; do
    [ -n "$port" ] || continue
    counter=$state/$name
    failures=$(cat "$counter" 2>/dev/null || echo 0)

    # svstat says "down" only after somebody ran svc -d. That is a decision,
    # not a fault - leave it alone.
    case "$(svstat "/etc/service/$name" 2>&1)" in
      *": down"*)
        [ -n "$dry" ] && echo "  $name: taken down deliberately, skipped"
        [ -n "$dry" ] || echo 0 > "$counter"
        continue
        ;;
    esac

    if health_probe "$port"; then
      [ -n "$dry" ] && echo "  $name: port $port answers"
      [ -n "$dry" ] && continue
      if [ "$failures" -gt 0 ]; then
        health_log "$log" "$name back after $failures min"
      fi
      echo 0 > "$counter"
      continue
    fi

    [ -n "$dry" ] && { echo "  $name: port $port SILENT (${failures} failed min so far)"; continue; }

    failures=$((failures + 1))
    echo "$failures" > "$counter"
    [ "$failures" = 1 ] && health_log "$log" "$name silent on port $port"
    [ "$failures" -ge "$HEALTH_GRACE" ] || continue

    # Act once every HEALTH_GRACE minutes rather than every minute: a restarted
    # process needs about forty seconds before it answers, and signalling it
    # again each minute would never let it get there. TERM first; if three
    # rounds of that changed nothing the process is wedged, so KILL.
    [ $((failures % HEALTH_GRACE)) -eq 0 ] || continue
    if [ "$failures" -ge $((HEALTH_GRACE * 3)) ]; then signal=-k; else signal=-t; fi
    health_log "$log" "$name silent for $failures min, svc $signal"
    echo "oddb_cron healthcheck: $name silent for $failures min on port $port, svc $signal"
    svc "$signal" "/etc/service/$name" 2>&1 ||
      health_log "$log" "$name svc $signal FAILED - check who owns /etc/service/$name/supervise"
  done <<HEALTH_EOF
$HEALTH
HEALTH_EOF
}

# Root writing into log/ would leave files the jobs running as zdavatz cannot
# append to - the same trap cmd_certbot_renew chowns its way out of.
health_log() {
  file=$1
  shift
  echo "$(date '+%Y-%m-%d %H:%M:%S %z') $*" >> "$file"
  [ "$(id -u)" = "0" ] && chown zdavatz:zdavatz "$file" 2>/dev/null
  return 0
}

# The schedule, so /etc/crontab needs one line for all nine jobs instead of
# nine. Fields: minute, hour, day-of-month ("*" for every day), job name.
# Keep them sorted by time; cron itself no longer knows about any of this.
#
# import_bsv and import_swissmedic overlap deliberately - see above.
#
# update_fachinfo_rss_feeds shares the 05:01 slot with update_today, and the
# order in this table is the order they run in: two entries for the same minute
# are dispatched one after the other by the loop below, so the second starts
# only once the first has released log/job.pid. It used to sit at 19:01, which
# meant /fachinfo.rss carried yesterday's Fachinfos all day - the texts arrive
# at 04:51 (swissmedicinfo) and are stored by update_today around 05:05, but
# the feed is a file on disk that Rss::PassThru serves verbatim, so it showed
# nothing new until the evening. update_today takes ~4 minutes, the feed ~5 for
# de, 10 for de/fr/en together and 30 with the yearly feeds. There is no
# data/rss/it - we currently have no Fachinfos in Italian, so that is expected.
SCHEDULE="
19  1   *   rebuild_indices
1   5   *   update_today
1   5   *   update_fachinfo_rss_feeds
1   7   *   update_drugshortage_hpc_dhcp
0   8   *   import_bsv
15  8   *   import_swissmedic
50  15  *   update_drugshortage
50  8   20  import_whocc
1   20  11  import_refdata_nat
30  6   5   repair_fachinfo_references
"

# Runs whatever is due this minute. Invoked once a minute from cron, so it has
# to stay cheap: on all but nine minutes of the day it matches nothing and
# exits. Times are compared without leading zeros so "08" from date matches "8".
cmd_schedule() {
  # Before the jobs, not after: a job can hold this invocation for an hour, and
  # the check is worth four HEAD requests a minute. Its exit status is
  # deliberately ignored - a wedged backend is not a failed schedule, and it
  # reports itself by printing, which cron turns into mail.
  cmd_healthcheck || true

  now_min=$(date +%-M)
  now_hour=$(date +%-H)
  now_dom=$(date +%-d)
  status=0
  # Fed by here-doc, not a pipe: a piped while runs in a subshell, and $status
  # set inside it would be lost - cron would never see a failing job.
  while read -r min hour dom job; do
    [ -n "$job" ] || continue
    [ "$min" = "$now_min" ] || continue
    [ "$hour" = "$now_hour" ] || continue
    [ "$dom" = "*" ] || [ "$dom" = "$now_dom" ] || continue
    cmd_job "$job" || status=1
  done <<SCHEDULE_EOF
$SCHEDULE
SCHEDULE_EOF
  return $status
}

# Prints the schedule, to check what this replaced the crontab lines with.
cmd_schedule_list() {
  echo "$SCHEDULE" | while read -r min hour dom job; do
    [ -n "$job" ] || continue
    printf "  %2s %2s %2s  %s\n" "$min" "$hour" "$dom" "$job"
  done
}

case "$1" in
  job)            shift; cmd_job "$@" ;;
  schedule)       cmd_schedule ;;
  schedule-list)  cmd_schedule_list ;;
  certbot-renew)  cmd_certbot_renew ;;
  backup)         cmd_backup ;;
  healthcheck)    shift; cmd_healthcheck "$@" ;;
  *)              usage ;;
esac
