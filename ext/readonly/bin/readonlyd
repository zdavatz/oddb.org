#!/usr/bin/env ruby

$: << File.expand_path("../src", File.dirname(__FILE__))
$: << File.expand_path("../../..", File.dirname(__FILE__))
$: << File.expand_path("../../../src", File.dirname(__FILE__))

require "odba"
require "rubygems"
require "models"
require "readonly_server"
require "util/oddbconfig"
require "etc/db_connection"
# Dieser Dienst haengt an derselben Datenbank wie die Rack-Backends, laedt
# aber util/oddbapp nicht - ohne diese Zeile vergibt er odba_ids aus einem
# eigenen Zaehler und ueberschreibt fremde Objekte. Siehe util/odba_id_patch.
require "util/odba_id_patch"

DRb.install_id_conv ODBA::DRbIdConv.new
DRb.start_service(ODDB::READONLY_URI, ODDB::ReadonlyServer.new)
$0 = "Oddb (Readonly)"
DRb.thread.join
