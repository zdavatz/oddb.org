#!/usr/local/bin/ruby
# Meldet Aerzte, die im aktuellen Refdata-Export kein aktiver DoctMed mehr
# sind, und entfernt sie auf Wunsch aus @doctors. Zwei Faelle:
# die GLN steht gar nicht mehr im Export, oder sie steht da mit
# STATUS != A ("inaktiv").
#
#   bundle exec ruby jobs/repair_vanished_doctors            # nur zaehlen
#   bundle exec ruby jobs/repair_vanished_doctors --apply
#
# Den STATUS-Fall entfernt der Import seit 25.11.2026 selbst
# (RefdataNatPlugin#prune_inactive); dieser Job raeumt den Rueckstand und
# bleibt fuer die GLN, die ganz aus dem Export fallen. Vorher zaehlte der
# Import solche Faelle nur in @doctors_inactive und schrieb sie in den
# Bericht ("Number of inactive doctors"), rief aber **nie**
# OddbPrevalence#delete_doctor. Ueber acht Jahre monatlicher Importe sind
# so Eintraege liegengeblieben: gemessen am 24.11.2026 fuehrte @doctors
# 127779 Eintraege, davon 116847 mit einer GLN, die im Export vom
# 11.10.2026 als DoctMed steht, und **6873 mit einer GLN, die dort nicht
# mehr vorkommt**. Am 25.11.2026 kamen die **7475** dazu, die im Export
# stehen, aber nicht mit STATUS=A: 120906 -> 113431 (= 109372 aktive im
# Export + 4059 ohne GLN).
#
# Nicht angetastet werden die 4059 Eintraege **ohne** ean13. Das sind
# Altbestaende aus der Zeit vor dem Refdata-Import (kleine laufende
# Schluessel wie 12 oder 4135 statt der achtstelligen, letzte Aenderung
# 2006-2014 oder keine); ohne GLN laesst sich nicht entscheiden, ob
# Refdata sie kennt.
#
# Entfernt wird nur aus @doctors, nicht mit odba_delete: damit bleibt das
# Objekt erhalten und die Undo-Datei genuegt, um es wieder einzuhaengen.
# Was dann wirklich unerreichbar ist, ist Sache von
# jobs/delete_unreachable_objects.
#
# Zur Vorsicht: "nicht mehr im Export" ist nicht dasselbe wie "von Refdata
# geloescht". Faellt ein Import aus oder laedt eine unvollstaendige Datei,
# sieht das gleich aus. Deshalb Trockenlauf als Standard, und die Zahl
# gehoert angeschaut, bevor --apply laeuft.

$: << File.expand_path("../src", File.dirname(__FILE__))
$: << File.expand_path("..", File.dirname(__FILE__))

require "util/job"
require "ox"

module ODDB
  module Util
    Job.run do |app|
      apply = ARGV.include?("--apply")
      xml_path = File.join(ODDB::WORK_DIR, "xml/refdata_nat_latest.xml")
      abort "kein Export unter #{xml_path}" unless File.exist?(xml_path)

      puts "Export: #{xml_path} (#{File.size(xml_path)} Bytes, #{File.mtime(xml_path).strftime("%d.%m.%Y")})"
      items = Ox.load(IO.read(xml_path), mode: :hash_no_attrs)
        .dig(:"soap:Envelope", :"soap:Body", :PARTNER, :ITEM)
      items = [items] unless items.is_a?(Array)
      doctmed = {}
      items.each { |item|
        next unless item.is_a?(Hash)
        roles = case item[:ROLE]
        when Hash then [item[:ROLE]]
        when Array then item[:ROLE]
        else []
        end
        next unless roles.any? { |one| one.is_a?(Hash) && one[:TYPE].eql?("DoctMed") }
        doctmed[item[:GLN].to_i] = item[:STATUS]
      }
      puts "DoctMed im Export: #{doctmed.size}"

      verschwunden = []
      inaktiv = []
      ohne_gln = 0
      app.doctors.each { |oid, doc|
        ean = begin
          doc.ean13.to_s
        rescue
          ""
        end
        if ean.empty?
          ohne_gln += 1
          next
        end
        status = doctmed[ean.to_i]
        next if status.eql?("A")
        name = begin
          [doc.name, doc.firstname].compact.join(", ")
        rescue
          "?"
        end
        # Zwei verschiedene Faelle, beide kein aktiver DoctMed: die GLN steht
        # gar nicht mehr im Export, oder sie steht da mit STATUS != A. Den
        # zweiten Fall entfernt der Import seit 25.11.2026 selbst
        # (RefdataNatPlugin#prune_inactive); dieser Lauf raeumt den Rueckstand
        # aus acht Jahren, in denen nie geloescht wurde.
        (status.nil? ? verschwunden : inaktiv) << [oid, ean, name]
      }

      puts "Aerzte in @doctors:              #{app.doctors.size}"
      puts "  ohne GLN (unberuehrt):         #{ohne_gln}"
      puts "  nicht mehr im Export:          #{verschwunden.size}"
      puts "  im Export, aber STATUS != A:   #{inaktiv.size}"
      (verschwunden.first(4) + inaktiv.first(4)).each { |oid, ean, name|
        puts format("    oid %-10s gln %-14s %s", oid, ean, name[0, 34])
      }
      verschwunden += inaktiv

      if verschwunden.empty?
        puts "nichts zu tun"
        next
      end
      unless apply
        puts
        puts "ohne --apply nichts geaendert"
        exit 1
      end

      undo = File.expand_path("../log/repair_vanished_doctors-#{Time.now.strftime("%Y%m%d-%H%M%S")}.undo",
        File.dirname(__FILE__))
      File.open(undo, "w") { |fh|
        verschwunden.each { |oid, ean, name| fh.puts([oid, ean, name].join("\t")) }
      }
      # In einem Durchgang, und die Liste einmal speichern. delete_doctor je
      # Arzt schreibt die Liste mit ihren 127779 Eintraegen so oft wie
      # geloescht wird: 262 Loeschungen brauchten am 24.11.2026 dreizehn
      # Minuten, die vollen 6873 waeren 5,7 Stunden gewesen - mit gehaltenem
      # log/job.pid, das um 01:19 rebuild_indices blockiert haette.
      start = Time.now
      entfernt = app.system.delete_doctors(verschwunden.collect(&:first))
      puts
      puts "#{entfernt.size} von #{verschwunden.size} aus @doctors entfernt in #{(Time.now - start).round(1)} s"
      puts "Liste in #{undo} (Spalten: oid, gln, name)"
      puts "nachlesen bitte in einem frischen Prozess"
    end
  end
end
