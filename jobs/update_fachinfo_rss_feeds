#!/usr/local/bin/ruby
# Update Fachinfo RSS Feeds
# Run this nightly to update fachinfo RSS feeds after using --skip during the day
# must be scheduled in crontab to run as the same user as oddb

$: << File.expand_path("../src", File.dirname(__FILE__))
$: << File.expand_path("..", File.dirname(__FILE__))

require "util/job"
require "plugin/text_info"
require "util/fachinfo_year_feeds"

module ODDB
  module Util
    Job.run do |system|
      puts "=" * 80
      puts "Starting Fachinfo RSS Feed Update - #{Time.now}"
      puts "=" * 80
      
      plugin = ODDB::TextInfoPlugin.new(system)
      
      # Update main fachinfo RSS feed
      puts "Updating main fachinfo.rss feed..."
      start_time = Time.now
      plugin.update_rss_feeds("fachinfo.rss", system.sorted_fachinfos, View::Rss::Fachinfo)
      duration = Time.now - start_time
      puts "Main feed updated in #{duration.round(2)} seconds"
      
      # Update yearly fachinfo feeds
      #
      # Nicht mehr plugin.update_yearly_fachinfo_feeds: das teilte den heutigen
      # Bestand nach dem Jahr der letzten Revision auf, so dass jede Fachinfo
      # in genau einem Jahr stand und alte Jahre schrumpften, sobald ein
      # Dokument wieder angefasst wurde. Die Jahre kommen jetzt aus dem
      # change_log der Dokumente, also aus den Aenderungen selbst.
      puts "\nUpdating yearly fachinfo feeds..."
      start_time = Time.now
      builder = FachinfoYearFeeds.new(system,
        root: File.expand_path("../data/rss", File.dirname(__FILE__)),
        logger: ->(line) { puts line })
      written = builder.write(builder.collect, apply: true)
      duration = Time.now - start_time
      puts "#{written} yearly feeds from #{builder.counts[:entries]} changes " \
        "in #{builder.counts[:fachinfos]} Fachinfos, #{duration.round(2)} seconds"
      
      # Store updates
      puts "\nSaving RSS updates to database..."
      system.odba_isolated_store
      
      puts "\n" + "=" * 80
      puts "Fachinfo RSS Feed Update Complete - #{Time.now}"
      puts "=" * 80
    end
  end
end
