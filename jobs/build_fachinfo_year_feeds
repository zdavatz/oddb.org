#!/usr/local/bin/ruby
# Baut die Jahresfeeds fachinfo-<jahr>.rss aus den Aenderungen der Dokumente.
#
#   bundle exec ruby jobs/build_fachinfo_year_feeds            # nur messen
#   bundle exec ruby jobs/build_fachinfo_year_feeds --apply
#   bundle exec ruby jobs/build_fachinfo_year_feeds --limit=200
#
# Warum nicht aus sorted_fachinfos: das sind die heutigen Fachinformationen,
# und jede hat genau ein revision-Datum. Die Jahresdateien waren damit eine
# Aufteilung des Bestands - 5053 Fachinfos, jede in genau einem Jahr - und
# alte Jahre schrumpften, sobald ein Dokument wieder angefasst wurde. Die
# Geschichte liegt im change_log, dort, wo auch die /diff/-Seiten herkommen.
#
# Der Lauf dauert rund zwoelf Minuten und bleibt bei etwa 280 MB. Ohne das
# odba_retire in FachinfoYearFeeds waeren es ueber zehn Gigabyte.

$: << File.expand_path("../src", File.dirname(__FILE__))
$: << File.expand_path("..", File.dirname(__FILE__))

require "util/job"
require "util/fachinfo_year_feeds"

module ODDB
  module Util
    Job.run do |system|
      apply = ARGV.include?("--apply")
      limit = ARGV.find { |a| a.start_with?("--limit=") }&.split("=")&.last&.to_i
      root = File.expand_path("../data/rss", File.dirname(__FILE__))

      started = Time.now
      builder = FachinfoYearFeeds.new(system, root: root, logger: ->(line) { puts line })
      buckets = builder.collect(limit: limit)

      puts
      puts "Fachinfos durchgegangen: #{builder.counts[:fachinfos]}"
      puts "Änderungen gefunden:     #{builder.counts[:entries]}"
      FachinfoYearFeeds::LANGUAGES.each_value.to_a.uniq.each { |lang|
        years = buckets[lang] || {}
        next if years.empty?
        total = years.values.sum(&:size)
        puts format("  %-3s %6d Einträge in %2d Jahren  %d .. %d",
          lang, total, years.size, years.keys.min, years.keys.max)
        years.keys.sort.each { |year|
          puts format("      %d %6d", year, years[year].size)
        }
      }

      unless apply
        puts
        puts "ohne --apply nichts geschrieben"
        next
      end

      written = builder.write(buckets, apply: true)
      if (latest = builder.latest(buckets))
        system.rss_updates["fachinfo.rss"] = latest
        system.odba_isolated_store
        puts "rss_updates[fachinfo.rss] = #{latest.inspect}"
      end
      puts
      puts "#{written} Jahresdateien geschrieben in #{(Time.now - started).round(1)}s"
    end
  end
end
